<Project>
  <!--
    The lean/.Reactive seam.

    Every Akavache assembly ships twice from one set of source files. Akavache.X compiles against
    ReactiveUI.Primitives, so its public API speaks RxVoid and ISequencer and it carries no
    System.Reactive at runtime. Akavache.X.Reactive links the same .cs files with REACTIVE_SHIM
    defined and compiles them against ReactiveUI.Primitives.Reactive — the same Primitives source
    recompiled with RxVoid bound to System.Reactive.Unit and ISequencer to IScheduler — so its
    public API is the System.Reactive one.

    The source names Primitives types directly (RxVoid, ISequencer, Signal, and the
    ReactiveUI.Primitives.Advanced sinks). Only the namespaces differ between leaves, and the
    aliases below supply them, so no .cs file carries a per-leaf using. Files that declare a
    namespace shift it under REACTIVE_SHIM, so the two assemblies never collide in a consumer
    that references both.

    RxReactiveSeam also matches '<leaf>.Reactive_<hash>_wpftmp', the WPF XAML markup-compile temp
    project, which does not itself end with 'Reactive'. No other Akavache name contains 'Reactive'.
  -->
  <PropertyGroup>
    <RxReactiveSeam Condition="$(MSBuildProjectName.EndsWith('Reactive')) or $(MSBuildProjectName.Contains('Reactive_'))">true</RxReactiveSeam>
    <!-- Projects that build against a published Akavache rather than this source tree (the v10/v11
         compatibility writers and the v10 comparison benchmark) set this to false: they resolve
         System.Reactive through those packages and must not get the seam's imports. -->
    <UsesAkavacheSeam Condition="'$(UsesAkavacheSeam)' == ''">true</UsesAkavacheSeam>
  </PropertyGroup>

  <!-- Disposables are the same package and namespace on both sides of the seam. -->
  <ItemGroup Condition="'$(UsesAkavacheSeam)' == 'true'">
    <Using Include="ReactiveUI.Primitives.Disposables" />
  </ItemGroup>

  <!-- Seam-exempt projects consume a published Akavache and so speak System.Reactive throughout. -->
  <ItemGroup Condition="'$(UsesAkavacheSeam)' != 'true'">
    <Using Include="System.Reactive" />
    <Using Include="System.Reactive.Concurrency" />
    <Using Include="System.Reactive.Disposables" />
    <Using Include="System.Reactive.Linq" />
    <Using Include="System.Reactive.Subjects" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsesAkavacheSeam)' == 'true' and '$(RxReactiveSeam)' != 'true'">
    <Using Include="ReactiveUI.Primitives" />
    <Using Include="ReactiveUI.Primitives.Advanced" />
    <Using Include="ReactiveUI.Primitives.Concurrency" />
    <Using Include="ReactiveUI.Primitives.Core" />
    <Using Include="ReactiveUI.Primitives.Signals" />
    <Using Include="ReactiveUI.Primitives.Extensions" />
  </ItemGroup>

  <!-- Primitives only shifts the types carrying RxVoid/ISequencer in their signatures, so the
       .Reactive leaf imports both the shifted namespaces and the seam-free Core ones. -->
  <PropertyGroup Condition="'$(RxReactiveSeam)' == 'true'">
    <DefineConstants>$(DefineConstants);REACTIVE_SHIM</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsesAkavacheSeam)' == 'true' and '$(RxReactiveSeam)' == 'true'">
    <!-- Deliberately no bare ReactiveUI.Primitives import here. Its SubscribeExtensions would tie
         with System.Reactive's ObservableExtensions.Subscribe on every call site; each leaf should
         bind Subscribe to its own stack. The types the source needs from that namespace all have a
         shifted counterpart under ReactiveUI.Primitives.Reactive. -->
    <Using Include="ReactiveUI.Primitives.Advanced" />
    <Using Include="ReactiveUI.Primitives.Core" />
    <Using Include="ReactiveUI.Primitives.Signals" />
    <Using Include="ReactiveUI.Primitives.Reactive" />
    <Using Include="ReactiveUI.Primitives.Reactive.Advanced" />
    <Using Include="ReactiveUI.Primitives.Reactive.Concurrency" />
    <Using Include="ReactiveUI.Primitives.Reactive.Core" />
    <Using Include="ReactiveUI.Primitives.Reactive.Signals" />
    <Using Include="ReactiveUI.Primitives.Extensions.Reactive" />
    <!-- Primitives.Reactive maps the whole scheduling contract onto System.Reactive's, so the
         sequencer names the source uses have no counterpart there and bind straight across. -->
    <Using Include="System.Reactive.Concurrency" />
    <Using Include="System.Reactive.Unit" Alias="RxVoid" />
    <Using Include="System.Reactive.Concurrency.IScheduler" Alias="ISequencer" />
    <Using Include="System.Reactive.Concurrency.Scheduler" Alias="Sequencer" />
    <Using Include="System.Reactive.Concurrency.TaskPoolScheduler" Alias="TaskPoolSequencer" />
    <Using Include="System.Reactive.Concurrency.ThreadPoolScheduler" Alias="ThreadPoolSequencer" />
    <Using Include="System.Reactive.Concurrency.ImmediateScheduler" Alias="ImmediateSequencer" />
    <Using Include="System.Reactive.Concurrency.CurrentThreadScheduler" Alias="CurrentThreadSequencer" />
  </ItemGroup>

  <PropertyGroup>
    <Copyright>Copyright (c) ReactiveUI and Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/reactiveui/akavache/</PackageProjectUrl>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>ReactiveUI and Contributors</Authors>
    <Owners>xanaisbettsx;glennawatson;chrispulman</Owners>
    <PackageTags>Akavache;Cache;Maui;Sqlite3;Magic</PackageTags>
    <PackageReleaseNotes>https://github.com/reactiveui/akavache/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/reactiveui/akavache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTestProject>$(MSBuildProjectName.Contains('Tests'))</IsTestProject>
    <DebugType>Embedded</DebugType>
    <!-- Optional: Publish the repository URL in the built .nupkg (in the NuSpec <Repository> element) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Optional: Embed source files that are not tracked by the source control manager in the PDB -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Optional: Include PDB in the built .nupkg -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <!-- disable sourcelink on mono, to workaround https://github.com/dotnet/sourcelink/issues/155 -->
    <WarningsAsErrors>CS860*;CS861*;CS862*;CS8630;CS8634;CS8766;CS8767</WarningsAsErrors>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Runs IDE* style analyzers during `dotnet build` so editorconfig severities for IDExxxx rules fire at compile time instead of only in the IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Enable building Windows-specific targets (net462/net472/net481 and netX.0-windows) on non-Windows platforms -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Base TFMs that build on any OS -->
    <AkavacheBaseTargets>net8.0;net9.0;net10.0</AkavacheBaseTargets>

    <!-- Windows-specific desktop TFMs (includes .NET Framework and Windows-specific .NET 9/10) -->
    <AkavacheWindowsDesktopTargets>net462;net472;net481;net8.0-windows10.0.19041.0;net9.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</AkavacheWindowsDesktopTargets>

    <!-- Mobile TFMs separated by platform. net9 mobile TFMs dropped: the MAUI net9
         (android/ios/maccatalyst) workloads are end of support (NETSDK1202). -->
    <AkavacheMobileAndroidTargets>net10.0-android</AkavacheMobileAndroidTargets>
    <AkavacheMobileAppleTargets>net10.0-ios;net10.0-macos;net10.0-maccatalyst</AkavacheMobileAppleTargets>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Start with base TFMs that are always included -->
    <AkavacheFinalTargetFrameworks>$(AkavacheBaseTargets)</AkavacheFinalTargetFrameworks>

    <!-- Add Android targets (Linux, macOS, Windows can all compile Android) -->
    <AkavacheFinalTargetFrameworks>$(AkavacheFinalTargetFrameworks);$(AkavacheMobileAndroidTargets)</AkavacheFinalTargetFrameworks>

    <!-- Add Windows Desktop TFMs. EnableWindowsTargeting above lets these build on non-Windows. -->
    <AkavacheFinalTargetFrameworks>$(AkavacheFinalTargetFrameworks);$(AkavacheWindowsDesktopTargets)</AkavacheFinalTargetFrameworks>

    <!-- Add Apple Mobile TFMs when building on macOS or Windows (Linux cannot compile Apple frameworks) -->
    <AkavacheFinalTargetFrameworks Condition="$([MSBuild]::IsOsPlatform('OSX')) OR $([MSBuild]::IsOsPlatform('Windows'))">$(AkavacheFinalTargetFrameworks);$(AkavacheMobileAppleTargets)</AkavacheFinalTargetFrameworks>
  </PropertyGroup>

  <!-- Workaround for Android file locking issues during parallel builds in CI -->
  <!-- See: https://github.com/xamarin/xamarin-android/issues/8074 -->
  <PropertyGroup Condition="'$(CI)' == 'true' and $(TargetFramework.Contains('-android'))">
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' != 'true' and ($(TargetFramework.StartsWith('net8.0')) or $(TargetFramework.StartsWith('net9.0')) or $(TargetFramework.StartsWith('net10.0')))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <NoWarn>$(NoWarn);CS0618;CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="$(MSBuildThisFileDirectory)..\Images\logo.png" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="Foundation" />
    <!-- System.Linq is not implicitly imported: LINQ on a cache hot path should be a deliberate,
         visible `using`, not something that compiles because the SDK imported it for you. -->
    <Using Remove="System.Linq" />
    <Using Include="System.Text"/>
  </ItemGroup>

  <!-- Alias Lock to the dedicated System.Threading.Lock on .NET 9+ (faster EnterScope fast path),
       and to a plain object elsewhere (the lock statement falls back to Monitor). Declaration sites
       stay identical across TFMs; only the bound type changes. -->
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">
    <Using Include="System.Threading.Lock" Alias="Lock" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">
    <Using Include="System.Object" Alias="Lock" />
  </ItemGroup>

  <!-- ArgumentExceptionHelper.ThrowIfNull(...) resolves straight to the runtime's optimized
       ArgumentNullException.ThrowIfNull on .NET 8.0+, and to the inline ArgumentValidation polyfill on
       older targets. Call sites stay identical across TFMs; only the bound symbol changes. Guards that
       ArgumentNullException does not carry (ThrowIfNullOrWhiteSpace/ThrowIf/EnsureNotNull/...) name
       ArgumentValidation directly; it forwards to the framework throw-helpers where they exist. -->
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <Using Include="System.ArgumentNullException" Alias="ArgumentExceptionHelper" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) and '$(RxReactiveSeam)' != 'true'">
    <Using Include="Akavache.Helpers.ArgumentValidation" Alias="ArgumentExceptionHelper" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) and '$(RxReactiveSeam)' == 'true'">
    <Using Include="Akavache.Reactive.Helpers.ArgumentValidation" Alias="ArgumentExceptionHelper" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'true' and '$(SourceLinkEnabled)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- TimeProvider ships in the framework from net8.0; .NET Framework needs the backport so the
       cache can take an injectable clock instead of reading the machine clock directly. -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TUnitImplicitUsings>true</TUnitImplicitUsings>
    <TUnitAssertionsImplicitUsings>true</TUnitAssertionsImplicitUsings>

  </PropertyGroup>
  <!-- MTP Native JSON Configuration -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)testconfig.json">
      <Link>$(AssemblyName).testconfig.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- Splat directly, not via ReactiveUI.Testing: that package pulls ReactiveUI.Core, which depends
         on the lean ReactiveUI.Primitives unconditionally and would make Signal ambiguous in a .Reactive twin. -->
    <PackageReference Include="Splat" />
  </ItemGroup>

  <!-- MinVer (versioning) — replaces Nerdbank.GitVersioning. Floor at 12.1
       so untagged builds produce 12.1.x-alpha.0.<height> until a v12.1.x
       (or later) tag is reachable. -->
  <PropertyGroup>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>12.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="StyleSharp.Analyzers" PrivateAssets="all" />
    <PackageReference Include="PerformanceSharp.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SecuritySharp.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="All" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
    <PackageReference Include="Blazor.Common.Analyzers" PrivateAssets="All" />
  </ItemGroup>

  <!-- Public-API tracking (RS0016 / RS0017 / RS0037): a per-TFM Shipped/Unshipped pair under
       <Project>/PublicAPI/<tfm>/. Both leaves of the seam are tracked, so a change to the shared
       source shows up as a diff on the lean and the .Reactive surface alike. Regenerate with
       tools/generate-publicapi.sh (or the .ps1 sibling on Windows, which reaches the Apple TFMs). -->
  <PropertyGroup>
    <TrackPublicApi Condition="'$(TrackPublicApi)' == ''">true</TrackPublicApi>
    <TrackPublicApi Condition="'$(IsTestProject)' == 'true'">false</TrackPublicApi>
    <!-- Nothing under these trees ships, so none of it has a public surface worth pinning. -->
    <TrackPublicApi Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)benchmarks$([System.IO.Path]::DirectorySeparatorChar)'))">false</TrackPublicApi>
    <TrackPublicApi Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)samples$([System.IO.Path]::DirectorySeparatorChar)'))">false</TrackPublicApi>
    <TrackPublicApi Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)compat$([System.IO.Path]::DirectorySeparatorChar)'))">false</TrackPublicApi>
    <!-- The WPF markup pass generates '<Project>_<hash>_wpftmp.csproj' in the real project's
         directory, so it resolves the same baseline path and would overwrite it. -->
    <TrackPublicApi Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">false</TrackPublicApi>
  </PropertyGroup>
  <ItemGroup Condition="'$(TrackPublicApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI\$(TargetFramework)\PublicAPI.*.txt" />
  </ItemGroup>
</Project>
