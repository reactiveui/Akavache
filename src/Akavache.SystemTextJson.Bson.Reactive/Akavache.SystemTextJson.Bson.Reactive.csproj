<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AkavacheFinalTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Akavache.SystemTextJson.Bson.Reactive</AssemblyName>
    <RootNamespace>Akavache.Reactive.SystemTextJson.Bson</RootNamespace>
    <PackageId>Akavache.SystemTextJson.Bson.Reactive</PackageId>
    <Description>System.Text.Json BSON serialization support for Akavache using Newtonsoft.Json.Bson for BSON encoding, recompiled against System.Reactive</Description>
    <PackageDescription>Akavache.SystemTextJson.Bson recompiled against System.Reactive's Unit and IScheduler, for consumers already on the System.Reactive stack.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akavache.SystemTextJson.Reactive\Akavache.SystemTextJson.Reactive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Newtonsoft.Json.Bson" />
    <PackageReference Include="ReactiveUI.Primitives.Reactive" ExcludeAssets="analyzers" />
  </ItemGroup>

  <!-- The same source the lean Akavache.SystemTextJson.Bson package ships, recompiled here under REACTIVE_SHIM. -->
  <ItemGroup>
    <Compile Include="..\Akavache.SystemTextJson.Bson\**\*.cs"
             Exclude="..\Akavache.SystemTextJson.Bson\obj\**\*.cs;..\Akavache.SystemTextJson.Bson\bin\**\*.cs"
             Link="Akavache.SystemTextJson.Bson\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Mirrors the lean project's shared-internals set; see Akavache.Sqlite3.csproj for the rationale. -->
  <ItemGroup>
    <Compile Include="..\Akavache.Core\Helpers\ArgumentValidation.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Akavache.Core\Helpers\BinaryHelpers.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Akavache.Core\Polyfills\*.cs" Link="Shared\Polyfills\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AkavacheInternalUsing Include="Akavache" />
    <AkavacheInternalUsing Include="Akavache.Core" />
    <AkavacheInternalUsing Include="Akavache.Helpers" />
    <AkavacheInternalUsing Include="Akavache.SystemTextJson" />
    <AkavacheInternalUsing Include="Akavache.SystemTextJson.Bson" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Akavache.Integration.Tests.Reactive" />
    <InternalsVisibleTo Include="Akavache.Integration.Tests.Parallel.Reactive" />
  </ItemGroup>
</Project>
