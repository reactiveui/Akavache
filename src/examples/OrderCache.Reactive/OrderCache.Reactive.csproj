    <ProjectReference Include="../../Akavache.Sqlite3.Reactive/Akavache.Sqlite3.Reactive.csproj" />
    <ProjectReference Include="../../Akavache.HttpDownloader.Reactive/Akavache.HttpDownloader.Reactive.csproj" />
    <ProjectReference Include="../../Akavache.Drawing.Reactive/Akavache.Drawing.Reactive.csproj" />
    <ProjectReference Include="../../Akavache.Settings.Reactive/Akavache.Settings.Reactive.csproj" />
    <Compile Include="../OrderCache/*.cs" Link="%(Filename)%(Extension)" />
    <AkavacheInternalUsing Include="Akavache" />
    <AkavacheInternalUsing Include="Akavache.Drawing" />
    <AkavacheInternalUsing Include="Akavache.NewtonsoftJson" />
    <AkavacheInternalUsing Include="Akavache.Sqlite3" />
    <AkavacheInternalUsing Include="Akavache.Settings.Core" />
