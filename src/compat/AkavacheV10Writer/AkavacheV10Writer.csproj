<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Builds against a published Akavache, not this source tree, so the lean/.Reactive seam does not apply. -->
    <UsesAkavacheSeam>false</UsesAkavacheSeam>
    <!-- Fossilised v10-format writer: references the published Akavache 10.2.41 package, whose
         transitive deps (sqlite-net-pcl 1.9.172, SQLitePCLRaw.bundle_green 2.1.11) are no longer
         part of the main CPM set. Disable transitive pinning here so restore uses the versions
         the v10 package itself requested. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Akavache" VersionOverride="10.2.41" />
    <PackageReference Include="Akavache.Sqlite3"  VersionOverride="10.2.41" />
  </ItemGroup>
</Project>
