<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AkavacheFinalTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Akavache.Settings</RootNamespace>
    <LangVersion>latest</LangVersion>

  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Akavache.Integration.Tests" />
    <InternalsVisibleTo Include="Akavache.Integration.Tests.Parallel" />
    <InternalsVisibleTo Include="Akavache.Settings.Tests" />
    <InternalsVisibleTo Include="Akavache.Settings.Tests.Parallel" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akavache.EncryptedSqlite3\Akavache.EncryptedSqlite3.csproj" />
    <ProjectReference Include="..\Akavache.Sqlite3\Akavache.Sqlite3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ReactiveUI.Primitives" ExcludeAssets="analyzers" />
  </ItemGroup>

  <!-- Akavache's own namespaces, turned into global usings by Directory.Build.targets (shifted to
       Akavache.Reactive.* on the .Reactive leaf). -->
  <ItemGroup>
    <AkavacheInternalUsing Include="Akavache" />
    <AkavacheInternalUsing Include="Akavache.Core" />
    <AkavacheInternalUsing Include="Akavache.Core.Observables" />
    <AkavacheInternalUsing Include="Akavache.EncryptedSqlite3" />
    <AkavacheInternalUsing Include="Akavache.Helpers" />
    <AkavacheInternalUsing Include="Akavache.Settings" />
    <AkavacheInternalUsing Include="Akavache.Settings.Core" />
    <AkavacheInternalUsing Include="Akavache.Sqlite3" />
  </ItemGroup>

  <!-- Shared internals from Akavache.Core (see Akavache.Sqlite3.csproj for rationale). -->
  <ItemGroup>
    <Compile Include="..\Akavache.Core\Helpers\ArgumentValidation.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Akavache.Core\Core\SecurityUtilities.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Akavache.Core\Core\Observables\*.cs" Link="Shared\Observables\%(Filename)%(Extension)" />
    <Compile Include="..\Akavache.Core\Polyfills\*.cs" Link="Shared\Polyfills\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
