<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AkavacheBaseTargets)</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>Akavache.Sqlite3.Tests.Parallel.Reactive</AssemblyName>
    <RootNamespace>Akavache.Reactive.Sqlite3.Tests.Parallel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Akavache.HttpDownloader.Reactive\Akavache.HttpDownloader.Reactive.csproj" />
    <ProjectReference Include="..\..\Akavache.Sqlite3.Reactive\Akavache.Sqlite3.Reactive.csproj" />
    <ProjectReference Include="..\..\Akavache.SystemTextJson.Reactive\Akavache.SystemTextJson.Reactive.csproj" />
    <ProjectReference Include="..\..\Akavache.SystemTextJson.Bson.Reactive\Akavache.SystemTextJson.Bson.Reactive.csproj" />
    <ProjectReference Include="..\..\Akavache.NewtonsoftJson.Reactive\Akavache.NewtonsoftJson.Reactive.csproj" />
  </ItemGroup>

  <!-- The same tests the lean Akavache.Sqlite3.Tests.Parallel assembly runs, recompiled here under REACTIVE_SHIM. -->
  <ItemGroup>
    <Compile Include="..\Akavache.Sqlite3.Tests.Parallel\**\*.cs" Exclude="..\Akavache.Sqlite3.Tests.Parallel\obj\**\*.cs;..\Akavache.Sqlite3.Tests.Parallel\bin\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\shared\Helpers\*.cs" Link="Helpers\%(Filename)%(Extension)" />
    <Compile Include="..\shared\Mocks\*.cs" Link="Mocks\%(Filename)%(Extension)" />
    <Compile Include="..\shared\TestBases\*.cs" Exclude="..\shared\TestBases\BlobCacheDownloadTestsBase.cs" Link="TestBases\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Akavache namespaces as global usings; Directory.Build.targets shifts them to Akavache.Reactive.*. -->
  <ItemGroup>
    <AkavacheInternalUsing Include="Akavache" />
    <AkavacheInternalUsing Include="Akavache.Core" />
    <AkavacheInternalUsing Include="Akavache.Core.Observables" />
    <AkavacheInternalUsing Include="Akavache.Helpers" />
    <AkavacheInternalUsing Include="Akavache.NewtonsoftJson" />
    <AkavacheInternalUsing Include="Akavache.Settings" />
    <AkavacheInternalUsing Include="Akavache.Sqlite3" />
    <AkavacheInternalUsing Include="Akavache.Sqlite3.Tests.Parallel" />
    <AkavacheInternalUsing Include="Akavache.SystemTextJson" />
    <AkavacheInternalUsing Include="Akavache.SystemTextJson.Bson" />
    <AkavacheInternalUsing Include="Akavache.Tests" />
    <AkavacheInternalUsing Include="Akavache.Tests.Helpers" />
    <AkavacheInternalUsing Include="Akavache.Tests.Mocks" />
    <AkavacheInternalUsing Include="Akavache.Tests.TestBases" />
  </ItemGroup>

</Project>
