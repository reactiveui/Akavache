<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AkavacheBaseTargets)</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>Akavache.Settings.Tests.Parallel.Reactive</AssemblyName>
    <RootNamespace>Akavache.Reactive.Settings.Tests.Parallel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Akavache.NewtonsoftJson.Reactive\Akavache.NewtonsoftJson.Reactive.csproj" />
    <ProjectReference Include="..\..\Akavache.SystemTextJson.Reactive\Akavache.SystemTextJson.Reactive.csproj" />
    <ProjectReference Include="..\..\Akavache.Settings.Reactive\Akavache.Settings.Reactive.csproj" />
  </ItemGroup>

  <!-- The same tests the lean Akavache.Settings.Tests.Parallel assembly runs, recompiled here under REACTIVE_SHIM. -->
  <ItemGroup>
    <Compile Include="..\Akavache.Settings.Tests.Parallel\**\*.cs" Exclude="..\Akavache.Settings.Tests.Parallel\obj\**\*.cs;..\Akavache.Settings.Tests.Parallel\bin\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Akavache.Settings.Tests\Mocks\*.cs" Link="Mocks\%(Filename)%(Extension)" />
    <Compile Include="..\Akavache.Settings.Tests\TestHelper.cs" Link="TestHelper.cs" />
    <Compile Include="..\shared\Helpers\Utility.cs" Link="Helpers\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Akavache namespaces as global usings; Directory.Build.targets shifts them to Akavache.Reactive.*. -->
  <ItemGroup>
    <AkavacheInternalUsing Include="Akavache" />
    <AkavacheInternalUsing Include="Akavache.Core" />
    <AkavacheInternalUsing Include="Akavache.Core.Observables" />
    <AkavacheInternalUsing Include="Akavache.EncryptedSettings.Tests" />
    <AkavacheInternalUsing Include="Akavache.EncryptedSqlite3" />
    <AkavacheInternalUsing Include="Akavache.Helpers" />
    <AkavacheInternalUsing Include="Akavache.NewtonsoftJson" />
    <AkavacheInternalUsing Include="Akavache.Settings" />
    <AkavacheInternalUsing Include="Akavache.Settings.Core" />
    <AkavacheInternalUsing Include="Akavache.Settings.Tests" />
    <AkavacheInternalUsing Include="Akavache.Sqlite3" />
    <AkavacheInternalUsing Include="Akavache.SystemTextJson" />
    <AkavacheInternalUsing Include="Akavache.Tests" />
    <AkavacheInternalUsing Include="Akavache.Tests.Helpers" />
  </ItemGroup>

</Project>
