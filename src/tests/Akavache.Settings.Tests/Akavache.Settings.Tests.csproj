<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AkavacheBaseTargets)</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="TUnit.Assertions" />
    <Using Include="TUnit.Assertions.Extensions" />
    <Using Include="TUnit.Core" />
    <Using Include="TUnit.Core.Executors" />
    <Using Include="Akavache.Settings.Tests.Executors" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Akavache.NewtonsoftJson\Akavache.NewtonsoftJson.csproj" />
    <ProjectReference Include="..\..\Akavache.SystemTextJson\Akavache.SystemTextJson.csproj" />
    <ProjectReference Include="..\..\Akavache.Settings\Akavache.Settings.csproj" />
  </ItemGroup>


  <!-- Akavache namespaces as global usings; Directory.Build.targets shifts them for the .Reactive twin. -->
  <ItemGroup>
    <AkavacheInternalUsing Include="Akavache" />
    <AkavacheInternalUsing Include="Akavache.Core" />
    <AkavacheInternalUsing Include="Akavache.Core.Observables" />
    <AkavacheInternalUsing Include="Akavache.EncryptedSqlite3" />
    <AkavacheInternalUsing Include="Akavache.Helpers" />
    <AkavacheInternalUsing Include="Akavache.NewtonsoftJson" />
    <AkavacheInternalUsing Include="Akavache.Settings" />
    <AkavacheInternalUsing Include="Akavache.Settings.Core" />
    <AkavacheInternalUsing Include="Akavache.Settings.Tests" />
    <AkavacheInternalUsing Include="Akavache.Settings.Tests.Executors" />
    <AkavacheInternalUsing Include="Akavache.Sqlite3" />
    <AkavacheInternalUsing Include="Akavache.SystemTextJson" />
  </ItemGroup>

</Project>
