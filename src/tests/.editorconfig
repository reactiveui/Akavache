# Inherits from ../../.editorconfig — no `root = true` here on purpose so the
# rules in the repo-level config still apply. This file only lists overrides
# that are tests-specific.

[*.cs]

###################
# Code Analysis (CA) - Disable rules for test projects
###################
dotnet_diagnostic.CA1001.severity = none # Owns disposable fields
dotnet_diagnostic.CA1063.severity = none # Implement IDisposable correctly
dotnet_diagnostic.CA1065.severity = none # Do not raise exceptions in unexpected locations
dotnet_diagnostic.CA1812.severity = none # Avoid uninstantiated internal classes
dotnet_diagnostic.CA2213.severity = none # Disposable fields should be disposed

###################
# PerformanceSharp / StyleSharp test relaxations imported from Primitives
###################
dotnet_diagnostic.SST1432.severity = none # Test fixtures need not be static
dotnet_diagnostic.SST2410.severity = none # A test creates the disposable it is asserting about; the test process owns it and exits
performancesharp.avoid_linq_on_hot_path = false
dotnet_diagnostic.PSH1100.severity = none # Tests can use LINQ for clarity
dotnet_diagnostic.PSH1101.severity = error # In tests, simplify LINQ Where plus terminal calls instead of banning LINQ
dotnet_diagnostic.PSH1102.severity = error # In tests, simplify LINQ type filters instead of banning LINQ

###################
# Akavache test-suite specifics
###################

# Test types are internal to the test runner and don't need DebuggerDisplay
# attributes; suppress here so the rule still applies to public production
# types.
dotnet_diagnostic.RCS1223.severity = none # Mark publicly visible type with DebuggerDisplay attribute — not useful for test fixtures

# Test fakes/mocks deliberately throw NotImplementedException from members the test doesn't exercise; this is intentional.
dotnet_diagnostic.RCS1079.severity = none # Implement the functionality instead of throwing new NotImplementedException — deliberate in test fakes
dotnet_diagnostic.SST2485.severity = none # 'throw new NotImplementedException' marks unfinished code — the same deliberate test-fake shape RCS1079 is disabled for

# The encryption tests must pass a password to open an encrypted cache, so the literal is the
# subject of the test rather than a leaked secret.
dotnet_diagnostic.SES1202.severity = none # A string literal is passed where a credential is expected — test fixtures supply their own throwaway passwords

# IDE0200 (lambda can be removed) is unsafe for TUnit Assert.That(...).Throws<T>() / .ThrowsNothing() patterns.
# Method-group conversion binds to a different Assert.That overload that does NOT invoke the delegate,
# so the throw assertion silently misses (or the no-throw assertion silently passes). Keep the explicit lambda.
dotnet_diagnostic.IDE0200.severity = none # Lambda expression can be removed — required for TUnit Assert.That throw-matchers
