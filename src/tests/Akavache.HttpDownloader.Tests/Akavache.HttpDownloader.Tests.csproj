<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AkavacheBaseTargets)</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Akavache.Core\Akavache.csproj" />
    <ProjectReference Include="..\..\Akavache.HttpDownloader\Akavache.HttpDownloader.csproj" />
    <ProjectReference Include="..\..\Akavache.Sqlite3\Akavache.Sqlite3.csproj" />
    <ProjectReference Include="..\..\Akavache.EncryptedSqlite3\Akavache.EncryptedSqlite3.csproj" />
    <ProjectReference Include="..\..\Akavache.SystemTextJson\Akavache.SystemTextJson.csproj" />
    <ProjectReference Include="..\..\Akavache.SystemTextJson.Bson\Akavache.SystemTextJson.Bson.csproj" />
    <ProjectReference Include="..\..\Akavache.NewtonsoftJson\Akavache.NewtonsoftJson.csproj" />
  </ItemGroup>

  <!-- Shared test infrastructure from tests/shared/. -->
  <ItemGroup>
    <Compile Include="..\shared\Helpers\*.cs" Link="Helpers\%(Filename)%(Extension)" />
    <Compile Include="..\shared\Mocks\*.cs" Exclude="..\shared\Mocks\InMemoryAkavacheConnection.cs" Link="Mocks\%(Filename)%(Extension)" />
    <Compile Include="..\shared\TestBases\BlobCacheDownloadTestsBase.cs" Link="TestBases\%(Filename)%(Extension)" />
  </ItemGroup>


  <!-- Akavache namespaces as global usings; Directory.Build.targets shifts them for the .Reactive twin. -->
  <ItemGroup>
    <AkavacheInternalUsing Include="Akavache" />
    <AkavacheInternalUsing Include="Akavache.Core" />
    <AkavacheInternalUsing Include="Akavache.Core.Observables" />
    <AkavacheInternalUsing Include="Akavache.EncryptedSqlite3" />
    <AkavacheInternalUsing Include="Akavache.Helpers" />
    <AkavacheInternalUsing Include="Akavache.HttpDownloader.Tests" />
    <AkavacheInternalUsing Include="Akavache.Integration.Tests" />
    <AkavacheInternalUsing Include="Akavache.NewtonsoftJson" />
    <AkavacheInternalUsing Include="Akavache.Settings" />
    <AkavacheInternalUsing Include="Akavache.Sqlite3" />
    <AkavacheInternalUsing Include="Akavache.SystemTextJson" />
    <AkavacheInternalUsing Include="Akavache.SystemTextJson.Bson" />
    <AkavacheInternalUsing Include="Akavache.Tests" />
    <AkavacheInternalUsing Include="Akavache.Tests.Helpers" />
    <AkavacheInternalUsing Include="Akavache.Tests.Mocks" />
  </ItemGroup>

</Project>
