<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AkavacheFinalTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Akavache.Settings.Reactive</AssemblyName>
    <RootNamespace>Akavache.Reactive.Settings</RootNamespace>
    <PackageId>Akavache.Settings.Reactive</PackageId>
    <PackageDescription>Akavache.Settings recompiled against System.Reactive's Unit and IScheduler, for consumers already on the System.Reactive stack.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akavache.EncryptedSqlite3.Reactive\Akavache.EncryptedSqlite3.Reactive.csproj" />
    <ProjectReference Include="..\Akavache.Sqlite3.Reactive\Akavache.Sqlite3.Reactive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ReactiveUI.Primitives.Reactive" ExcludeAssets="analyzers" />
  </ItemGroup>

  <!-- The same source the lean Akavache.Settings package ships, recompiled here under REACTIVE_SHIM. -->
  <ItemGroup>
    <Compile Include="..\Akavache.Settings\**\*.cs"
             Exclude="..\Akavache.Settings\obj\**\*.cs;..\Akavache.Settings\bin\**\*.cs"
             Link="Akavache.Settings\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Mirrors the lean project's shared-internals set; see Akavache.Sqlite3.csproj for the rationale. -->
  <ItemGroup>
    <Compile Include="..\Akavache.Core\Helpers\ArgumentValidation.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Akavache.Core\Core\SecurityUtilities.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Akavache.Core\Core\Observables\*.cs" Link="Shared\Observables\%(Filename)%(Extension)" />
    <Compile Include="..\Akavache.Core\Polyfills\*.cs" Link="Shared\Polyfills\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AkavacheInternalUsing Include="Akavache" />
    <AkavacheInternalUsing Include="Akavache.Core" />
    <AkavacheInternalUsing Include="Akavache.Core.Observables" />
    <AkavacheInternalUsing Include="Akavache.EncryptedSqlite3" />
    <AkavacheInternalUsing Include="Akavache.Helpers" />
    <AkavacheInternalUsing Include="Akavache.Settings" />
    <AkavacheInternalUsing Include="Akavache.Settings.Core" />
    <AkavacheInternalUsing Include="Akavache.Sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Akavache.Integration.Tests.Reactive" />
    <InternalsVisibleTo Include="Akavache.Integration.Tests.Parallel.Reactive" />
    <InternalsVisibleTo Include="Akavache.Settings.Tests.Reactive" />
    <InternalsVisibleTo Include="Akavache.Settings.Tests.Parallel.Reactive" />
  </ItemGroup>
</Project>
